{
  "version": 6,
  "configurePresets": [
    {
      "name": "native-headless",
      "displayName": "Native i686, headless (no SDL)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/port/native-headless",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_C_FLAGS": "-m32",
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "native-asan",
      "displayName": "Native i686, headless, ASan + UBSan",
      "inherits": "native-headless",
      "binaryDir": "${sourceDir}/build/port/native-asan",
      "cacheVariables": {
        "CMAKE_C_FLAGS": "-m32 -fsanitize=address,undefined -fno-sanitize=function -fno-omit-frame-pointer -fno-sanitize-recover=undefined",
        "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=address,undefined -shared-libasan"
      }
    },
    {
      "name": "web",
      "displayName": "WebAssembly game objects, PsyQ and Backend (no link)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/port/web",
      "toolchainFile": "$env{EMSDK}/upstream/emscripten/cmake/Modules/Platform/Emscripten.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "web",
      "configurePreset": "web",
      "targets": ["dw1_game_objs", "dw1_backend", "dw1_psyq"]
    },
    {
      "name": "native-headless",
      "configurePreset": "native-headless"
    },
    {
      "name": "native-asan",
      "configurePreset": "native-asan"
    }
  ],
  "testPresets": [
    {
      "name": "native-headless",
      "configurePreset": "native-headless",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "native-asan",
      "configurePreset": "native-asan",
      "output": {
        "outputOnFailure": true
      },
      "environment": {
        "ASAN_OPTIONS": "detect_stack_use_after_return=0"
      }
    }
  ]
}
