{
  "version": 6,
  "configurePresets": [
    {
      "name": "native-headless",
      "displayName": "Native i686, headless (no SDL)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/port/native-headless",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_C_FLAGS": "-m32",
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "DW1_HOST": "headless"
      }
    },
    {
      "name": "native",
      "displayName": "Native i686, SDL3 window",
      "inherits": "native-headless",
      "binaryDir": "${sourceDir}/build/port/native",
      "cacheVariables": {
        "DW1_HOST": "sdl",
        "CMAKE_PREFIX_PATH": "$env{SDL3_NATIVE32_PREFIX}"
      }
    },
    {
      "name": "native-asan",
      "displayName": "Native i686, headless, ASan + UBSan",
      "inherits": "native-headless",
      "binaryDir": "${sourceDir}/build/port/native-asan",
      "cacheVariables": {
        "CMAKE_C_FLAGS": "-m32 -fsanitize=address,undefined -fno-sanitize=function -fno-omit-frame-pointer -fno-sanitize-recover=undefined",
        "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=address,undefined -shared-libasan"
      }
    },
    {
      "name": "web",
      "displayName": "WebAssembly game on a pthread with WebGL2 presentation",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/port/web",
      "toolchainFile": "$env{EMSDK}/upstream/emscripten/cmake/Modules/Platform/Emscripten.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "web",
      "configurePreset": "web"
    },
    {
      "name": "native-headless",
      "configurePreset": "native-headless"
    },
    {
      "name": "native-asan",
      "configurePreset": "native-asan"
    },
    {
      "name": "native",
      "configurePreset": "native"
    }
  ],
  "testPresets": [
    {
      "name": "native-headless",
      "configurePreset": "native-headless",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "native-asan",
      "configurePreset": "native-asan",
      "output": {
        "outputOnFailure": true
      },
      "environment": {
        "ASAN_OPTIONS": "detect_stack_use_after_return=0"
      }
    },
    {
      "name": "web",
      "configurePreset": "web",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "native",
      "configurePreset": "native",
      "output": {
        "outputOnFailure": true
      },
      "filter": {
        "include": {
          "name": "^(sdl_.*|audio_rate|sjis_literals|native_sdl_title_capture|scene_naming_compare)$"
        }
      }
    }
  ]
}
