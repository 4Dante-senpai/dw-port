# One-shot independent arithmetic from psx-spx, no imports of the GTE under test.
def signed32(n):
    return (n + 2**31) % 2**32 - 2**31

def divide(h,z):
    if h >= z*2: return 131071, 0x20000
    shift = 16-z.bit_length()
    d = z*2**shift
    index = (d-0x7fc0)//128
    u = max(0,(0x40000//(index+256)+1)//2-257)+257
    r = (0x2000080-d*u)//256
    r = (128+r*u)//256
    return min(131071,(h*2**shift*r+32768)//65536),0

def projection(v,t,h,offset,dqa,dqb,sf=1,lm=0):
    flag=0
    m=[(v[i]+t[i])*4096 for i in range(3)]
    mac=[signed32(n//(4096 if sf else 1)) for n in m]
    ir=[]
    for i,n in enumerate(mac):
        low=0 if lm else -32768
        ir.append(min(32767,max(low,n)))
        test=m[2]//4096 if i==2 else n
        if test < (-32768 if i==2 else low) or test>32767: flag|=1<<(24-i)
    z=min(65535,max(0,m[2]//4096))
    if z!=m[2]//4096: flag|=0x40000
    q,f=divide(h,z); flag|=f
    xy=[]
    for i in range(2):
        n=q*ir[i]+offset[i]
        if n>2**31-1:flag|=0x10000
        if n< -2**31:flag|=0x8000
        raw=n//65536
        xy.append(min(1023,max(-1024,raw)))
        if raw!=xy[-1]:flag|=1<<(14-i)
    cue=q*dqa+dqb
    if cue>2**31-1:flag|=0x10000
    if cue< -2**31:flag|=0x8000
    ir0=min(4096,max(0,cue//4096))
    if ir0!=cue//4096:flag|=0x1000
    if flag & 0x7f87e000: flag|=0x80000000
    return [((xy[1]&65535)<<16)|(xy[0]&65535),z,*ir,signed32(cue),ir0,flag],mac,q
cases=[
('normal',(100,-50,1000),(10,-20,0),500,(160*65536,120*65536),64,4096,1,0),
