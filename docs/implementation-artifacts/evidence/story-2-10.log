L=[[4096,2048,0],[0,4096,1024],[1024,0,4096]]
C=[[4096,0,2048],[1024,4096,0],[0,2048,4096]]
for v in [[1024,2048,3072],[4096,1024,2048],[512,4096,1024]]:
    light=[sum(a*b for a,b in zip(row,v))//4096 for row in L]
    color=[bk+sum(a*b for a,b in zip(row,light))//4096 for bk,row in zip([128,256,512],C)]
    mac=[c*i*16//4096 for c,i in zip([128,64,32],color)]
