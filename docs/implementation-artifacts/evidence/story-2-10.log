for name,v,t,h,o,a,b,sf,lm in cases:
    result,mac,q=projection(v,t,h,o,a,b,sf,lm)
    vec=lambda xs:'{ '+', '.join(map(str,xs))+' }'
    print('        { "'+name+'", '+vec(v)+', '+vec(t)+f', {h}, '+vec(o)+f', {a}, {b}, {sf}, {lm},')
    print('          '+vec(result[:-1])+f', 0x{result[-1]:08X}u'+' }, /* MAC '+str(mac)+'; Q '+str(q)+' */')
