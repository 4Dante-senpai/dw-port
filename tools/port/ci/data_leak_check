#!/usr/bin/env python3
"""Build the artifact/exception scopes without writing any disc data."""
import os
from pathlib import Path
import subprocess
import sys

if len(sys.argv) != 3:
    sys.exit('usage: data_leak_check <web-build> <repo>')
build, root = (Path(p).resolve() for p in sys.argv[1:])
pack = build / 'us.pack'
if not os.environ.get('DW1_DISC_DIR') or not pack.is_file():
    print('data_leak_check: DW1_DISC_DIR or us.pack missing; skipped')
    sys.exit(77)
try:
    tool = root / 'build/port/native-headless/dw1-leak-check'
    game = sorted((build / 'CMakeFiles/dw1_game_objs.dir').rglob('*.o'))
    port = sorted(p for p in (build / 'CMakeFiles').rglob('*.o')
                  if 'dw1_game_objs.dir' not in p.parts)
    tracked = subprocess.check_output(['git', '-C', str(root), 'ls-files', '--stage', '-z']).split(b'\0')
    source, tree = [], []
    for record in filter(None, tracked):
        meta, name = record.split(b'\t', 1)
        if meta.startswith(b'160000 '):
            continue
        path = Path(os.fsdecode(name))
        if not (root / path).exists():
            continue  # Deleted tracked files are absent from the current build tree.
        (source if path.parts[0] in ('src', 'include') else tree).append(root / path)
    if not game or not port or not source or not tree:
        raise ValueError('empty artifact/exception scope')
    deploy = [build / name for name in (
        'dw1.html', 'dw1.js', 'io_worker.js', 'audio_worklet.js', 'sw.js',
        'dw1_pack.js', 'dw1_pack.wasm', 'us.tsv')]
    failed = False
    for name, exceptions, artifacts in [('wasm', game, [build / 'dw1.wasm']),
                                         ('deploy', [], deploy), ('port', [], port), ('tree', source, tree)]:
        print(f'scope={name} exceptions={len(exceptions)} artifacts={len(artifacts)}', flush=True)
        options = ['--wasm-map', str(build / 'dw1.map')] if name == 'wasm' else []
        result = subprocess.run([str(tool), *options, '--disc', str(pack), '--exception',
                                 *map(str, exceptions), '--', *map(str, artifacts)])
        if result.returncode not in (0, 1):
            sys.exit(result.returncode if result.returncode > 0 else 2)
        failed |= result.returncode == 1
    sys.exit(int(failed))
except (OSError, ValueError) as error:
    print(f'data_leak_check: {error}', file=sys.stderr)
    sys.exit(2)
