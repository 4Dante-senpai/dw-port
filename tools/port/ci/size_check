#!/usr/bin/env node
'use strict';
const fs = require('fs'), path = require('path'), vm = require('vm'), zlib = require('zlib');
try {
  const [build, ...args] = process.argv.slice(2);
  if (!build || args.length % 2) throw Error('usage: size_check <build> [--wasm-limit N] [--first-load-limit N]');
  const limits = {'--wasm-limit':4000000, '--first-load-limit':6000000};
  for (let i = 0; i < args.length; i += 2) {
    if (!(args[i] in limits) || !/^\d+$/.test(args[i+1]) || !Number.isSafeInteger(Number(args[i+1])))
      throw Error('invalid limit: ' + args[i]);
    limits[args[i]] = Number(args[i+1]);
  }
  const source = fs.readFileSync(path.join(build, 'sw.js'), 'utf8');
  const match = source.match(/const FILES\s*=\s*(\[[\s\S]*?\]);/);
  if (!match) throw Error('sw.js: FILES missing');
  const files = vm.runInNewContext(match[1], Object.create(null), {timeout:1000});
  if (!Array.isArray(files) || !files.length || files.some(f => typeof f !== 'string' || !f.startsWith('/') || f.includes('..')))
    throw Error('sw.js: invalid FILES');
  if (!files.includes('/sw.js')) files.push('/sw.js');
  if (fs.existsSync(path.join(build, 'version.txt'))) files.push('/version.txt');
  let total = 0, wasm;
  for (const file of files) {
    const name = file === '/' ? 'dw1.html' : file.slice(1);
    const size = zlib.brotliCompressSync(fs.readFileSync(path.join(build, name)), {
      params:{[zlib.constants.BROTLI_PARAM_QUALITY]:11}}).length;
    console.log(`${name}: brotli_bytes=${size}`);
    total += size;
    if (name === 'dw1.wasm') wasm = size;
  }
  console.log(`first_load: brotli_bytes=${total}`);
  if (wasm === undefined) throw Error('dw1.wasm missing from FILES');
  if (wasm > limits['--wasm-limit']) throw Error(`dw1.wasm exceeds --wasm-limit ${limits['--wasm-limit']}`);
  if (total > limits['--first-load-limit']) throw Error(`first load exceeds --first-load-limit ${limits['--first-load-limit']}`);
} catch (error) { console.error(error.message); process.exitCode = 1; }
